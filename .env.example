# Copy to .env and fill in real values. NEVER commit .env.
#
#   cp .env.example .env
#
# The gateway and the C# reporting worker both read these names, so one file
# configures the whole stack.

# ----------------------------------------------------------------- database --
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cypher
DB_USER=cypher_user
DB_PASSWORD=change-me

# ---------------------------------------------------------------------- jwt --
# Signing key for the tokens this API issues (base64, at least 32 decoded
# bytes). Generate one with:  openssl rand -base64 64
# Required by docker compose; without it the app uses its development key.
# JWT_SECRET=

# ----------------------------------------------------------------- websocket --
# Extra origins allowed to open the live incident socket (/ws/incidents).
# Leave empty when this app serves the cockpit itself.
# WS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------ server --
SERVER_PORT=8081

# ------------------------------------------------------------- monitoring --
# Anonymous viewers can read the provisioned CYPHER dashboard. The admin
# account can still edit, so replace this value anywhere outside local demos.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy

# --------------------------------------------------------------------- S3 --
# Production (EC2): leave endpoint and static keys blank. The backend uses the
# instance role and the private bucket's resource policy.
# S3_BUCKET=cypher-media-587748224148-ap-south-1
# AWS_REGION=ap-south-1
# S3_MEDIA_PREFIX=cypher/incidents
#
# Offline Compose demo: use docker-compose.media.yml instead of setting these
# by hand.

# ------------------------------------------------------------------- CI/CD --
# Jenkins is the optional `ci` Compose profile at http://localhost:8088.
JENKINS_ADMIN_PASSWORD=change-me-before-starting-jenkins
