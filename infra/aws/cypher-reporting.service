[Unit]
Description=CYPHER incident exports
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cypher
ExecStart=/bin/bash /home/ubuntu/cypher/infra/aws/cypher-start-reporting.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
